---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection("blog")).sort((a, b) => +b.data.date - +a.data.date);
  return paginate(posts, { pageSize: 20 });
}
const { page } = Astro.props;
---
<Base title={`Blog page ${page.currentPage}`} description="All posts">
  <h1>Blog</h1>
  <ul>{page.data.map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a> — {p.data.description}</li>)}</ul>
  {page.url.prev && <a href={page.url.prev}>Newer</a>} {page.url.next && <a href={page.url.next}>Older</a>}
</Base>
