{
  "name": "velocita",
  "version": "1.0.0",
  "description": "Zero-dependency, zero-JS-by-default static site framework for content websites. Sonic speed + SEO/GEO built in.",
  "type": "module",
  "bin": {
    "velocita": "bin/velocita.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "build:example": "node bin/velocita.js build example",
    "dev:example": "node bin/velocita.js dev example",
    "deploy:demo": "node scripts/deploy-demo.mjs",
    "dev:site": "node bin/velocita.js dev site",
    "build:site": "node bin/velocita.js build site --strict --check",
    "typecheck": "npx -y -p typescript@5 tsc --noEmit --strict --skipLibCheck false src/index.d.ts types-test/check.ts",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ssg",
    "static-site-generator",
    "seo",
    "markdown",
    "fast",
    "content",
    "blog",
    "geo",
    "llms.txt"
  ],
  "license": "MIT",
  "devDependencies": {
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "sharp": ">=0.33"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6t9xstar/velocita.git"
  },
  "homepage": "https://github.com/6t9xstar/velocita#readme",
  "types": "src/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/6t9xstar/velocita/issues"
  }
}
